# Python virtual environment
venv/

# Python compiled files
__pycache__/
*.pyc
*.pyo
*.pyd

# Microsoft Word lock files
~$*.docx
*.tmp

# SQLite databases
db.sqlite3
*.sqlite3

# Shared ranking cache files (runtime artifacts, recreated on demand)
data/cache/

# Runtime logs (django_errors.log, security.log) — written per machine
logs/

# Admin backup snapshots — large runtime files, server-side only
backups/

# Uploaded media (news photos etc.) — lives on the server, not in git
media/

# Local server ops scripts — run manually, never pushed to the repo
server_healthcheck.py
